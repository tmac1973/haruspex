# Generated by Cargo
# will have compiled files and executables
/target/
/target-e2e/
/gen/schemas

# App command permissions build.rs and tauri-build write from src/lib.rs on
# every build. permissions/no-agent-window.toml is written by hand.
/permissions/autogenerated/
/permissions/all-commands.toml

# ts-rs default export dir — created when `cargo test` runs without
# TS_RS_EXPORT_DIR. The canonical generated bindings live in
# src/lib/ipc/gen (exported via TS_RS_EXPORT_DIR=../src/lib/ipc/gen).
/bindings/
