{
	"name": "haruspex",
	"private": true,
	"version": "0.2.3",
	"license": "GPL-3.0-or-later",
	"author": "Tim MacDonald <tbaxmacdonald@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tmac1973/haruspex.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint src/",
		"format": "prettier --write 'src/**/*.{ts,svelte,js,css,html}'",
		"format:check": "prettier --check 'src/**/*.{ts,svelte,js,css,html}'",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e:ui": "playwright test",
		"e2e:ui:visual": "scripts/e2e-ui-visual.sh",
		"e2e:app:build": "node e2e/app/build.mjs",
		"e2e:app": "wdio run e2e/app/wdio.conf.mjs",
		"e2e:fake-llm": "node e2e/fake-llm/server.mjs",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.10.1",
		"@testing-library/svelte": "^5.0.0",
		"@types/marked": "^5.0.2",
		"@wdio/cli": "^10.0.0",
		"@wdio/local-runner": "^10.0.0",
		"@wdio/mocha-framework": "^10.0.0",
		"@wdio/spec-reporter": "^10.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.0",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.0.12",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/plugin-dialog": "^2.6.0",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/addon-serialize": "^0.13.0",
		"@xterm/addon-web-links": "^0.11.0",
		"@xterm/xterm": "^5.5.0",
		"dompurify": "^3.4.9",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.5",
		"pdfjs-dist": "^6.4.299",
		"pyodide": "^0.29.4"
	}
}
