# Dependencies
node_modules/

# Build output
dist/
build/
.svelte-kit/

# Rust / Tauri
src-tauri/target/
src-tauri/target-e2e/

# Model files (downloaded at runtime)
checkpoints/
data/
src-tauri/checkpoints/
src-tauri/data/

# Sidecar build directory (Windows local builds)
.sidecar-build/

# Sidecar binaries and libs (large, built separately). Everything but the
# placeholder, so binaries left over from an older naming scheme stay out too.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Pyodide runtime (downloaded by scripts/fetch-pyodide.sh, ~14 MB)
static/pyodide/

# plotly.min.js (extracted from the plotly wheel by scripts/fetch-pyodide.sh)
static/plotly/

# Environment files
.env
.env.*
!.env.example

# Credentials
*.pem
*.key
*.p12
*.pfx

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/e2e/app/output/
